{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"javascript": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 4,
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"linter": {
		"rules": {
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"useIterableCallbackReturn": "off"
			},
			"style": {
				"useConst": "error",
				"noDoneCallback": "error",
				"noNonNullAssertion": "error"
			}
		}
	}
}
